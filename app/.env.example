# --- Frontend (Vite) env. Copy to .env.local and fill in. ---

# From `npx convex dev` (printed on first run, also in .env.local it writes).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# VAPID PUBLIC key (base64url). Generate with: npx web-push generate-vapid-keys
# The PUBLIC key goes here; the PRIVATE key goes into Convex env (see README).
VITE_VAPID_PUBLIC_KEY=
